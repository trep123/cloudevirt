# 管理后端配置样例：仅占位值，禁止提交真实密钥
DJANGO_SECRET_KEY=replace-with-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# 通过 nginx 用外部 IP / 域名访问时，必须把访问用的 IP 或域名加进来
# 例：DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.20,cloudvirt.example.com
# 写操作（登录、创建、删除等）还需把完整来源加入 CSRF 信任列表，协议与域名须完全一致
# 例：DJANGO_CSRF_TRUSTED_ORIGINS=http://192.168.1.20,https://cloudvirt.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# 经代理透传 Host 时开启（nginx 已设置 Host 头，一般无需开启）
DJANGO_USE_X_FORWARDED_HOST=false
# 仅在后端监听本机、由可信 nginx 覆盖转发头时启用
DJANGO_TRUST_PROXY=false
# 通过 HTTPS 部署时均应设置为 true
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_LOG_LEVEL=INFO
DATABASE_URL=postgresql://cloudvirt:change-me@127.0.0.1:5432/cloudvirt

# 节点 Agent 共享令牌，与 Agent 的 CLOUDVIRT_AGENT_TOKEN 必须一致且长度足够
AGENT_SHARED_TOKEN=replace-with-at-least-32-random-bytes
# 调用 Agent 的超时时间（秒）
AGENT_REQUEST_TIMEOUT_SECONDS=30
# 控制台需 HTTPS；临时本机开发才可关闭 TLS 检查
CONSOLE_REQUIRE_TLS=true
CONSOLE_MAX_SESSIONS=3
# 可选媒体网关：信令保持本机，视频通过受限 ICE 端口传输
MEDIA_WHEP_BASE_URL=http://127.0.0.1:8889
MEDIA_API_BASE_URL=http://127.0.0.1:9997
BROADCAST_MAX_VIEWERS=16
MEDIA_STUN_URLS=
MEDIA_TURN_URLS=
# TURN REST 密钥只保存在服务器，勿使用真实值替换样例并提交
MEDIA_TURN_SECRET=
# 节点心跳采集周期与离线判定阈值（秒）
NODE_HEARTBEAT_INTERVAL_SECONDS=30
NODE_OFFLINE_AFTER_SECONDS=90

CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173

# 普通账号配额（包含关机实例与创建中的实例；管理员不受此配额限制）
USER_QUOTA_INSTANCES=10
USER_QUOTA_VCPU=32
USER_QUOTA_MEMORY_MIB=65536
USER_QUOTA_DISK_GIB=1024
