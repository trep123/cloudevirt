# Install as /etc/cloudvirt/network.env, root:cloudvirt-agent, mode 0640.
# Install.sh detects protected interfaces automatically on first deployment.
CLOUDVIRT_PROTECTED_INTERFACES=eno1
# Explicit operator-selected exemptions; addresses/routes are not migrated.
CLOUDVIRT_BRIDGE_ALLOWED_INTERFACES=
# Preserved by install.sh on upgrades; use cloudvirtctl enable/disable network-bridge.
CLOUDVIRT_NETWORK_BRIDGE_ENABLED=true
