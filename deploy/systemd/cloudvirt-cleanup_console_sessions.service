[Unit]
Description=CloudVirt expired desktop and media session cleanup
After=cloudvirt-management.service cloudvirt-agent.service

[Service]
Type=oneshot
User=cloudvirt
Group=cloudvirt
WorkingDirectory=/opt/cloudvirt/apps/management
EnvironmentFile=/etc/cloudvirt/management.env
ExecStart=/opt/cloudvirt/.venv/bin/python manage.py cleanup_console_sessions
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
