[Unit]
Description=CloudVirt broadcast publisher reconciliation
After=cloudvirt-management.service cloudvirt-agent.service cloudvirt-media.service
[Service]
Type=oneshot
User=cloudvirt
Group=cloudvirt
WorkingDirectory=/opt/cloudvirt/apps/management
EnvironmentFile=/etc/cloudvirt/management.env
ExecStart=/opt/cloudvirt/.venv/bin/python manage.py reconcile_broadcasts
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
