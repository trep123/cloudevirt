# 节点 Agent 配置样例：仅占位值，禁止提交真实密钥
# 监听地址：默认本机；跨机部署需显式绑定管理网 IP 并用防火墙限制来源
CLOUDVIRT_AGENT_LISTEN=127.0.0.1:9100
CLOUDVIRT_AGENT_TOKEN=replace-with-at-least-32-random-bytes
CLOUDVIRT_IMAGE_DIR=/var/lib/cloudvirt/images
CLOUDVIRT_DISK_DIR=/var/lib/cloudvirt/disks
CLOUDVIRT_MAX_REQUEST_SECONDS=120
CLOUDVIRT_ALLOW_DESTRUCTIVE=false
CLOUDVIRT_AGENT_VERSION=0.1.0
